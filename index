      ctx.fillStyle = 'rgba(255,255,255,0.95)';
      ctx.fillText('Foto 100% akurat', textRightX, 114);
      ctx.restore();

      if (STATE.logoImageObj) {
        ctx.save();
        ctx.shadowColor = 'rgba(0,0,0,0.45)';
        ctx.shadowBlur = 10;
        ctx.shadowOffsetY = 3;
        ctx.beginPath();
        ctx.arc(logoCenterX, logoCenterY, logoSize / 2, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,0.96)';
        ctx.fill();
        ctx.lineWidth = 3;
        ctx.strokeStyle = '#ffffff';
        ctx.stroke();
        ctx.restore();

        ctx.save();
        ctx.beginPath();
        ctx.arc(logoCenterX, logoCenterY, (logoSize / 2) - 4, 0, Math.PI * 2);
        ctx.clip();
        drawImageCover(
          ctx,
          STATE.logoImageObj,
          logoCenterX - (logoSize / 2) + 4,
