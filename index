    // Memantau status permission kamera & memicu akses otomatis saat tab/gesture aktif
    async function checkCameraPermissionState() {
      try {
        if (!navigator.permissions || !navigator.permissions.query) return 'unknown';
        const status = await navigator.permissions.query({ name: 'camera' });
        const syncPermissionLabel = () => {
          const labelEl = document.getElementById('cameraPermissionLabel');
          const btnEl = document.getElementById('btnAllowBrowserCamera');
          if (!labelEl || !btnEl) return;
          if (status.state === 'granted') {
            labelEl.textContent = 'Kamera Diizinkan';
            btnEl.className = 'px-2.5 py-1 rounded-full bg-emerald-600/80 text-white text-[10px] font-bold flex items-center gap-1 transition active:scale-95';
          } else if (status.state === 'denied') {
            labelEl.textContent = 'Buka Izin Browser';
            btnEl.className = 'px-2.5 py-1 rounded-full bg-rose-600/90 hover:bg-rose-500 text-white text-[10px] font-bold flex items-center gap-1 transition active:scale-95';
          } else {
            labelEl.textContent = 'Izinkan Kamera';
            btnEl.className = 'px-2.5 py-1 rounded-full bg-amber-500/90 hover:bg-amber-400 text-slate-950 text-[10px] font-extrabold flex items-center gap-1 transition active:scale-95';
          }
        };
        syncPermissionLabel();
        status.onchange = () => {
          syncPermissionLabel();
          if (status.state === 'granted') {
            requestAlwaysAllowCamera(null, { silent: true });
          }
        };
        return status.state;
      } catch (e) {
        return 'unknown';
      }
    }

    async function allowBrowserCameraNow() {
      const permState = await checkCameraPermissionState();
      if (permState === 'denied') {
        document.getElementById('cameraFallbackUI').classList.remove('hidden');
        document.getElementById('cameraErrorMsg').textContent =
          'Izin kamera diblokir di pengaturan browser. Ketuk ikon kunci/pengaturan di bilah alamat browser, aktifkan Kamera -> Izinkan, lalu ketuk Coba Lagi.';
        showToast('Aktifkan izin Kamera di pengaturan situs browser Anda.', 'error');
        return;
      }
      showToast('Meminta izin kamera browser...', 'info');
      await requestAlwaysAllowCamera(STATE.facingMode || 'user', { silent: false });
      await checkCameraPermissionState();
    }

    function bindAlwaysAllowCameraListeners() {
      if (STATE.autoCameraRetryBound) return;
      STATE.autoCameraRetryBound = true;

      checkCameraPermissionState();

      const resumeCameraIfNeeded = () => {
        const viewCam = document.getElementById('viewCamera');
        const isCameraTabActive = viewCam && !viewCam.classList.contains('hidden');
        const hasActiveStream = STATE.stream && STATE.stream.getVideoTracks().some(t => t.readyState === 'live');
        if (isCameraTabActive && !STATE.uploadedImageObj && !hasActiveStream) {
          requestAlwaysAllowCamera(null, { silent: true });
        }
      };

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
          resumeCameraIfNeeded();
        }
      });

      window.addEventListener('focus', resumeCameraIfNeeded);

      // Pada beberapa browser HP (terutama iOS Safari), interaksi sentuh pertama mempermudah aktivasi kamera
      const onFirstGesture = () => {
        resumeCameraIfNeeded();
      };
      window.addEventListener('pointerdown', onFirstGesture, { passive: true });
      window.addEventListener('touchstart', onFirstGesture, { passive: true });
    }

    async function requestAlwaysAllowCamera(requestedFacing = null, options = {}) {
      const { silent = false } = options;
      if (STATE.isStartingCamera) return;
      STATE.isStartingCamera = true;
      try {
        await startCamera(requestedFacing, { silent });
      } finally {
        STATE.isStartingCamera = false;
      }
    }

    async function startCamera(requestedFacing = null, options = {}) {
      const { silent = false } = options;
      const video = document.getElementById('videoPreview');
      const fallbackUI = document.getElementById('cameraFallbackUI');
      const uploadedImg = document.getElementById('uploadedFallbackImg');
      const targetFacing = requestedFacing || STATE.facingMode || 'user';

      if (STATE.stream) {
        STATE.stream.getTracks().forEach(track => track.stop());
      }

      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        fallbackUI.classList.remove('hidden');
        return;
      }

      try {
        // Konfigurasi ramah Android & iPhone (iOS Safari kadang menolak resolusi ketat)
        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
        const constraints = isIOS
          ? {
              video: {
                facingMode: targetFacing
              },
              audio: false
            }
          : {
              video: {
                facingMode: { ideal: targetFacing },
                width: { ideal: 1080 },
                height: { ideal: 1440 }
              },
              audio: false
            };

        const stream = await navigator.mediaDevices.getUserMedia(constraints);
        STATE.stream = stream;
        STATE.facingMode = targetFacing;
        STATE.uploadedImageObj = null;

        // Jaga agar stream kamera tetap aktif dan otomatis dipulihkan bila track berhenti
        stream.getVideoTracks().forEach((track) => {
          track.onended = () => {
            const viewCam = document.getElementById('viewCamera');
            if (viewCam && !viewCam.classList.contains('hidden') && !STATE.uploadedImageObj) {
              requestAlwaysAllowCamera(STATE.facingMode, { silent: true });
            }
          };
        });

        // Kamera depan default di-mirror, kamera belakang tidak di-mirror
        STATE.isMirrored = targetFacing === 'user';
        if (STATE.isMirrored) {
          video.classList.add('mirror-video');
        } else {
          video.classList.remove('mirror-video');
        }
        updateCameraFacingUI();

        video.setAttribute('playsinline', 'true');
        video.setAttribute('webkit-playsinline', 'true');
        video.muted = true;
        video.srcObject = stream;
        video.classList.remove('hidden');
        uploadedImg.classList.add('hidden');
        fallbackUI.classList.add('hidden');

        if (typeof video.play === 'function') {
          await video.play().catch(() => {});
        }
      } catch (err) {
        console.warn('Kamera gagal diakses:', err);
        document.getElementById('cameraErrorMsg').textContent =
          'Akses kamera di browser belum diizinkan (' + (err.name || 'Error') + '). Pilih "Izinkan" pada prompt browser atau buka pengaturan situs browser -> Kamera -> Izinkan, lalu ketuk Coba Lagi.';
        if (!silent || err.name === 'NotAllowedError' || err.name === 'PermissionDeniedError') {
          fallbackUI.classList.remove('hidden');
        }
        await checkCameraPermissionState();
      }
    }

