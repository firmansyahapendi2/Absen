        ctx.arc(attLogoCenterX, attLogoCenterY, rightLogoSize / 2, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,0.96)';
        ctx.fill();
        ctx.lineWidth = 4;
        ctx.strokeStyle = '#ffffff';
        ctx.stroke();
        ctx.restore();

        ctx.save();
        ctx.beginPath();
        ctx.arc(attLogoCenterX, attLogoCenterY, (rightLogoSize / 2) - 5, 0, Math.PI * 2);
        ctx.clip();
        drawImageCover(
          ctx,
          STATE.logoImageObj,
          attLogoCenterX - (rightLogoSize / 2) + 5,
          attLogoCenterY - (rightLogoSize / 2) + 5,
          rightLogoSize - 10,
          rightLogoSize - 10,
          false
        );
        ctx.restore();
      }

      // Garis vertikal di kiri sesuai jenis absensi (hijau masuk / biru pulang)
      ctx.fillStyle = themeColor;
      ctx.fillRect(36, blockTopY + 4, 8, textBlockHeight - 4);

      ctx.save();
      ctx.shadowColor = 'rgba(0,0,0,0.85)';
      ctx.shadowBlur = 8;
      ctx.shadowOffsetY = 2;

      let cursorY = blockTopY + 34;
      // Tanggal Lengkap
      ctx.fillStyle = '#ffffff';
      ctx.font = '700 32px Inter, sans-serif';
      ctx.fillText(dateStr, 58, cursorY);
      cursorY += 40;

      // Alamat Lokasi
      ctx.font = '500 28px Inter, sans-serif';
      ctx.fillStyle = 'rgba(255,255,255,0.96)';
      addressLines.forEach(line => {
        ctx.fillText(line, 58, cursorY);
        cursorY += lineHeight;
      });

      // Nama Pegawai & Unit Kerja (jika diisi)
      if (userLineText) {
        ctx.font = '700 26px Inter, sans-serif';
        ctx.fillStyle = '#fde047'; // Kuning lembut
        ctx.fillText(userLineText, 58, cursorY + 2);
      }
      ctx.restore();

      // 6. Badge Status ("Absen Masuk" / "Absen Pulang") + Kotak Putih Jam Besar ("16:54")
      const badgeH = 66;
      const badgeY = blockTopY - badgeH - 22;
      const badgeX = 36;

      ctx.font = '700 31px Inter, sans-serif';
      const statusTextWidth = ctx.measureText(STATE.attendanceType).width;
      const blueBoxW = statusTextWidth + 36;

      ctx.font = '900 44px Inter, sans-serif';
      const timeTextWidth = ctx.measureText(metrics.currentTimeStr).width;
      const whiteBoxW = timeTextWidth + 34;

      const totalBadgeW = blueBoxW + whiteBoxW;

      ctx.save();
      ctx.shadowColor = 'rgba(0,0,0,0.45)';
      ctx.shadowBlur = 14;
      ctx.shadowOffsetY = 4;
      drawRoundedRect(ctx, badgeX, badgeY, totalBadgeW, badgeH, 14);
      ctx.fillStyle = '#ffffff';
      ctx.fill();
      ctx.restore();

      ctx.save();
      drawRoundedRect(ctx, badgeX, badgeY, totalBadgeW, badgeH, 14);
      ctx.clip();

      // Kotak Warna Kiri (Hijau Absen Masuk / Biru Absen Pulang)
      ctx.fillStyle = themeColor;
      ctx.fillRect(badgeX, badgeY, blueBoxW, badgeH);

      // Kotak Putih Kanan
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(badgeX + blueBoxW, badgeY, whiteBoxW, badgeH);

      // Teks Badge & Jam Besar
      ctx.textAlign = 'left';
      ctx.textBaseline = 'middle';
      ctx.fillStyle = '#ffffff';
      ctx.font = '700 31px Inter, sans-serif';
      ctx.fillText(STATE.attendanceType, badgeX + 18, badgeY + (badgeH / 2) + 1);

      ctx.fillStyle = '#0f172a';
      ctx.font = '900 44px Inter, sans-serif';
      ctx.fillText(metrics.currentTimeStr, badgeX + blueBoxW + 17, badgeY + (badgeH / 2) + 2);
      ctx.restore();

      // 7. Banner Footer Solid hanya untuk Absen Pulang (kotak hijau Absen Masuk dihilangkan)
      if (isPulang) {
        ctx.fillStyle = themeColor;
        ctx.fillRect(0, footerY, W, footerH);

        ctx.fillStyle = 'rgba(255,255,255,0.88)';
        ctx.font = '500 25px Inter, sans-serif';
        ctx.textAlign = 'left';
        ctx.textBaseline = 'alphabetic';
        ctx.fillText('Jam Masuk', 38, footerY + 46);

        ctx.fillStyle = '#ffffff';
        ctx.font = '800 46px Inter, sans-serif';
        ctx.fillText(metrics.checkInTime, 38, footerY + 108);

        ctx.fillStyle = 'rgba(255,255,255,0.88)';
        ctx.font = '500 25px Inter, sans-serif';
        ctx.fillText('Lama Waktu Kerja', W * 0.50, footerY + 46);

        ctx.fillStyle = '#ffffff';
        ctx.font = '800 46px Inter, sans-serif';
        ctx.fillText(metrics.durationText, W * 0.50, footerY + 108);
      }

      // Export Final JPEG
      const dataUrl = canvas.toDataURL('image/jpeg', 0.92);
      STATE.currentResultDataUrl = dataUrl;

      const record = {
        id: Date.now(),
        nama: namaPegawai || 'Pegawai BAPELTAN',
        unitKerja: unitKerjaPegawai || '-',
        jenis: STATE.attendanceType,
        tanggal: dateStr,
        jam: metrics.currentTimeStr,
        jamMasuk: metrics.checkInTime,
        durasi: metrics.durationText,
        alamat: STATE.address,
        koordinat: `${STATE.coords.lat.toFixed(6)}, ${STATE.coords.lng.toFixed(6)}`,
        kodeVerifikasi: verifyCode,
        imageDataUrl: dataUrl
      };

      STATE.currentResultRecord = record;
      saveRecordToHistory(record);

      // Jika Absen Masuk, simpan otomatis jam masuk hari ini agar menu langsung beralih ke Absen Pulang
      if (STATE.attendanceType === 'Absen Masuk') {
        const todayKey = getTodayDateKey();
        localStorage.setItem('bapeltan_checkin_' + todayKey, JSON.stringify({ time: metrics.currentTimeStr }));
        document.getElementById('inputCheckInTime').value = metrics.currentTimeStr;
        applyCheckInLockState(true, metrics.currentTimeStr);
      }

      // Tampilkan modal hasil
      document.getElementById('finalWatermarkedImg').src = dataUrl;
      openModal('resultModal');
      showToast(`${STATE.attendanceType} berhasil direkam!`, 'success');
    }

    function drawImageCover(ctx, source, x, y, w, h, mirror = false) {
      const srcW = source.videoWidth || source.naturalWidth || source.width;
      const srcH = source.videoHeight || source.naturalHeight || source.height;
      if (!srcW || !srcH) return;

      const srcRatio = srcW / srcH;
      const dstRatio = w / h;
      let drawW, drawH, offsetX, offsetY;

      if (srcRatio > dstRatio) {
        drawH = h;
        drawW = h * srcRatio;
        offsetX = x + (w - drawW) / 2;
        offsetY = y;
      } else {
        drawW = w;
        drawH = w / srcRatio;
        offsetX = x;
        offsetY = y + (h - drawH) / 2;
      }

      ctx.save();
      if (mirror) {
        ctx.translate(x + w, y);
        ctx.scale(-1, 1);
        ctx.drawImage(source, offsetX - x, offsetY - y, drawW, drawH);
      } else {
        ctx.drawImage(source, offsetX, offsetY, drawW, drawH);
      }
      ctx.restore();
    }

    // ==========================================
    // INTEGRASI SHARE KE WHATSAPP & DOWNLOAD
    // ==========================================
    function buildWhatsAppCaption(rec) {
      const nama = (rec.nama || 'Pegawai').trim();
      const keterangan = (rec.jenis || 'Absen Masuk').trim();
      return `${nama}, ${keterangan}`;
    }

    async function shareToWhatsApp() {
      const rec = STATE.currentResultRecord;
      if (!rec || !STATE.currentResultDataUrl) return;

      const caption = buildWhatsAppCaption(rec);
      const fileName = `BAPELTAN_${rec.jenis.replace(/\s+/g, '_')}_${rec.jam.replace(':', '')}.jpg`;

      try {
        // Konversi DataURL menjadi File Blob untuk Web Share API (Mobile Android/iOS)
        const response = await fetch(STATE.currentResultDataUrl);
        const blob = await response.blob();
        const file = new File([blob], fileName, { type: 'image/jpeg' });

        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          await navigator.share({
            files: [file],
            title: `BAPELTAN Absensi - ${rec.jenis}`,
            text: caption
          });
          showToast('Berhasil dibagikan ke WhatsApp!', 'success');
          return;
        }
      } catch (err) {
        if (err && err.name === 'AbortError') return;
        console.warn('Web Share API file tidak didukung, beralih ke fallback:', err);
      }

      // Fallback untuk Desktop / Browser yang tidak mendukung Web Share File
      downloadCurrentPhoto();
      showToast('Foto diunduh! Membuka WhatsApp Web...', 'info');
      setTimeout(() => {
        shareTextOnlyWhatsApp();
      }, 700);
    }

    function shareTextOnlyWhatsApp() {
      const rec = STATE.currentResultRecord;
      if (!rec) return;
      const caption = encodeURIComponent(buildWhatsAppCaption(rec));
      window.open(`https://api.whatsapp.com/send?text=${caption}`, '_blank');
    }

    function downloadCurrentPhoto() {
      const rec = STATE.currentResultRecord;
      if (!STATE.currentResultDataUrl || !rec) return;

      const link = document.createElement('a');
      const cleanDate = new Date().toISOString().slice(0, 10).replace(/-/g, '');
      const cleanTime = rec.jam.replace(':', '');
      link.download = `BAPELTAN_${rec.jenis.replace(/\s+/g, '_')}_${cleanDate}_${cleanTime}.jpg`;
      link.href = STATE.currentResultDataUrl;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast('Foto tersimpan di perangkat!', 'success');
    }

    // ==========================================
    // RIWAYAT LOKAL
    // ==========================================
    function saveRecordToHistory(record) {
      STATE.history.unshift(record);
      if (STATE.history.length > 20) {
        STATE.history = STATE.history.slice(0, 20);
      }
      try {
        localStorage.setItem('bapeltan_history', JSON.stringify(STATE.history));
      } catch (e) {
        // Jika quota penuh, simpan 5 terakhir saja
        STATE.history = STATE.history.slice(0, 5);
        localStorage.setItem('bapeltan_history', JSON.stringify(STATE.history));
      }
      renderHistoryList();
    }

    function renderHistoryList() {
      const container = document.getElementById('historyListContainer');
      const badge = document.getElementById('historyBadge');

      if (STATE.history.length > 0) {
        badge.textContent = STATE.history.length;
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }

      if (STATE.history.length === 0) {
        container.innerHTML = `
          <div class="bg-white rounded-2xl p-8 text-center border border-slate-200/80">
            <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3">
              <i data-lucide="camera-off" class="w-6 h-6"></i>
            </div>
            <p class="text-sm font-bold text-slate-700">Belum Ada Riwayat Absensi</p>
            <p class="text-xs text-slate-500 mt-1">Foto absen masuk & pulang Anda akan tersimpan otomatis di sini.</p>
          </div>
        `;
        lucide.createIcons();
        return;
      }

      container.innerHTML = STATE.history.map((item, idx) => `
        <div class="bg-white rounded-2xl p-3 shadow-sm border border-slate-200/80 flex gap-3 items-center">
          <img src="${item.imageDataUrl}" onclick="openHistoryItem(${idx})" alt="Thumb" class="w-16 h-20 rounded-xl object-cover bg-slate-900 cursor-pointer border border-slate-200 shrink-0" />
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-1.5 mb-1">
              <span class="px-2 py-0.5 rounded-md text-[10px] font-extrabold ${item.jenis === 'Absen Masuk' ? 'bg-emerald-100 text-emerald-700' : 'bg-blue-100 text-[#0077E6]'}">
                ${item.jenis}
              </span>
              <span class="text-xs font-black text-slate-800">${item.jam}</span>
            </div>
            <p class="text-xs font-bold text-slate-800 truncate">${item.nama}</p>
            <p class="text-[11px] text-slate-500 truncate">${item.unitKerja && item.unitKerja !== '-' ? item.unitKerja : item.tanggal}</p>
            <p class="text-[10px] text-slate-400 truncate mt-0.5">${item.jenis === 'Absen Masuk' ? `Jam Masuk: ${item.jam}` : `Masuk ${item.jamMasuk || '-'} • Lama Kerja: ${item.durasi}`}</p>
          </div>
          <button onclick="openHistoryItem(${idx})" class="p-2.5 rounded-xl bg-[#25D366]/15 hover:bg-[#25D366]/25 text-emerald-700 transition shrink-0" title="Lihat & Share WA">
            <i data-lucide="share-2" class="w-4 h-4"></i>
          </button>
        </div>
      `).join('');
      lucide.createIcons();
    }

    function openHistoryItem(index) {
      const item = STATE.history[index];
      if (!item) return;
      STATE.currentResultRecord = item;
      STATE.currentResultDataUrl = item.imageDataUrl;
      document.getElementById('finalWatermarkedImg').src = item.imageDataUrl;
      openModal('resultModal');
    }

    function clearAllHistory() {
      STATE.history = [];
      localStorage.removeItem('bapeltan_history');
      renderHistoryList();
      showToast('Semua riwayat absensi telah dihapus.', 'info');
    }
  </script>
