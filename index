<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="theme-color" content="#0077E6" />
  <title>BAPELTAN Absensi - Sistem Absensi Foto & GPS</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            bapeltan: {
              50: '#eff8ff',
              100: '#dbeefe',
              500: '#0077E6',
              600: '#0062c4',
              700: '#004ea0',
            }
          }
        }
      }
    }
  </script>
  <style>
    html {
      touch-action: manipulation;
      -webkit-text-size-adjust: 100%;
    }
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f1f5f9;
      -webkit-tap-highlight-color: transparent;
      overscroll-behavior-y: contain;
    }
    .mirror-video {
      transform: scaleX(-1);
      -webkit-transform: scaleX(-1);
    }
    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 999px;
    }
    @keyframes pulse-ring {
      0% { transform: scale(0.85); opacity: 0.8; }
      70% { transform: scale(1.6); opacity: 0; }
      100% { transform: scale(1.6); opacity: 0; }
    }
    .gps-pulse::before {
      content: '';
      position: absolute;
      inset: -4px;
      border-radius: 9999px;
      background-color: #0077E6;
      animation: pulse-ring 2s infinite;
    }
  </style>
</head>
<body class="text-slate-800 min-h-screen flex flex-col">

  <!-- Toast Notification Container -->
  <div id="toastContainer" style="top: calc(1rem + env(safe-area-inset-top, 0px));" class="fixed left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 w-[92%] max-w-md pointer-events-none"></div>

  <script>
    // Membuat emblem default BAPELTAN di canvas agar selalu tersedia & bisa digambar ke foto hasil
    window.createDefaultBapeltanLogoDataUrl = function () {
      const c = document.createElement('canvas');
      c.width = 240;
      c.height = 240;
      const g = c.getContext('2d');

      g.clearRect(0, 0, 240, 240);
      g.fillStyle = '#ffffff';
      g.beginPath();
      g.arc(120, 120, 114, 0, Math.PI * 2);
      g.fill();

      // Cincin gradasi hijau - biru - kuning
      const ringGrad = g.createLinearGradient(20, 20, 220, 220);
      ringGrad.addColorStop(0, '#0ea5e9');
      ringGrad.addColorStop(0.5, '#16a34a');
      ringGrad.addColorStop(1, '#eab308');
      g.lineWidth = 10;
      g.strokeStyle = ringGrad;
      g.beginPath();
      g.arc(120, 120, 110, 0, Math.PI * 2);
      g.stroke();

      // Teks DINASTPH JABAR di bagian atas
      g.textAlign = 'center';
      g.font = '900 22px Inter, sans-serif';
      g.fillStyle = '#ea580c';
      g.fillText('DINAS', 92, 62);
      g.fillStyle = '#15803d';
      g.fillText('TPH', 146, 62);
      g.font = '800 14px Inter, sans-serif';
      g.fillStyle = '#166534';
      g.fillText('JABAR', 152, 78);

      // Aksara/lidah api kuning & lengkung hijau kiri
      g.fillStyle = '#facc15';
      g.beginPath();
      g.moveTo(46, 138);
      g.quadraticCurveTo(36, 98, 56, 72);
      g.quadraticCurveTo(64, 106, 56, 138);
      g.closePath();
      g.fill();

      g.strokeStyle = '#16a34a';
      g.lineWidth = 12;
      g.lineCap = 'round';
      g.beginPath();
      g.arc(54, 134, 24, Math.PI * 0.3, Math.PI * 1.65);
      g.stroke();

      // Tulisan utama "Bapeltan"
      g.font = '900 46px Inter, sans-serif';
      g.lineWidth = 5;
      g.strokeStyle = '#15803d';
      g.strokeText('Bapeltan', 124, 148);
      g.fillStyle = '#1d4ed8';
      g.fillText('Bapeltan', 124, 148);

      // Subjudul instansi di bawah
      g.font = '800 12px Inter, sans-serif';
      g.fillStyle = '#15803d';
      g.fillText('Tanaman Pangan & Hortikultura', 120, 174);

      return c.toDataURL('image/png');
    };

    window.syncLogoToAllTargets = function (srcUrl) {
      if (!srcUrl) return;
      const targets = ['appLogoImg', 'overlayLogoImg', 'dateBannerLogoImg'];
      targets.forEach((id) => {
        const el = document.getElementById(id);
        if (el) {
          if (el.getAttribute('src') !== srcUrl) {
            el.setAttribute('src', srcUrl);
          }
          el.classList.remove('hidden');
          if (el.parentElement) el.parentElement.classList.remove('hidden');
        }
      });

      const fallbackIcon = document.getElementById('appLogoFallbackIcon');
      if (fallbackIcon) fallbackIcon.classList.add('hidden');

      const imgObj = new Image();
      imgObj.crossOrigin = 'anonymous';
      imgObj.onload = () => {
        if (typeof STATE !== 'undefined') {
          STATE.logoImageObj = imgObj;
        }
      };
      imgObj.src = srcUrl;
    };

    // Didefinisikan lebih awal agar selalu tersedia saat event onload/onerror pada <img> logo dipicu
    window.handleLogoLoaded = function (imgEl) {
      if (!imgEl || !imgEl.complete || imgEl.naturalWidth === 0) {
        window.handleLogoError(imgEl);
        return;
      }
      imgEl.classList.remove('hidden');
      if (imgEl.parentElement) imgEl.parentElement.classList.remove('hidden');
      const fallbackIcon = document.getElementById('appLogoFallbackIcon');
      if (fallbackIcon) fallbackIcon.classList.add('hidden');

      if (typeof STATE !== 'undefined') {
        const canvasLogo = new Image();
        canvasLogo.crossOrigin = 'anonymous';
        canvasLogo.onload = () => {
          STATE.logoImageObj = canvasLogo;
        };
        canvasLogo.src = imgEl.src;
      }
    };

    window.handleLogoError = function (imgEl) {
      let savedLogo = '';
      try {
        savedLogo = localStorage.getItem('bapeltan_custom_logo') || '';
      } catch (e) {
        savedLogo = '';
      }
      const fallbackUrl = savedLogo || window.createDefaultBapeltanLogoDataUrl();
      if (imgEl && imgEl.dataset.fallbackApplied !== '1') {
        imgEl.dataset.fallbackApplied = '1';
        imgEl.src = fallbackUrl;
        imgEl.classList.remove('hidden');
        if (imgEl.parentElement) imgEl.parentElement.classList.remove('hidden');
      }
      window.syncLogoToAllTargets(fallbackUrl);
    };

    window.applyLogoDataUrl = function (dataUrl) {
      window.syncLogoToAllTargets(dataUrl);
    };

    window.handleCustomLogoUpload = function (event) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;
      if (!file.type.startsWith('image/')) {
        if (typeof showToast === 'function') showToast('Pilih file gambar logo yang valid.', 'error');
        return;
      }

      const reader = new FileReader();
      reader.onload = function (e) {
        const dataUrl = e.target.result;
        window.applyLogoDataUrl(dataUrl);
        try {
          localStorage.setItem('bapeltan_custom_logo', dataUrl);
        } catch (err) {
          console.warn('Logo terlalu besar untuk disimpan di localStorage:', err);
        }
        if (typeof showToast === 'function') showToast('Logo BAPELTAN berhasil diperbarui!', 'success');
      };
      reader.readAsDataURL(file);
    };
  </script>

  <!-- Top App Header -->
  <header style="padding-top: env(safe-area-inset-top, 0px);" class="sticky top-0 z-30 bg-[#0077E6] text-white shadow-md">
    <div class="max-w-[430px] mx-auto px-3.5 py-2.5 flex items-center justify-between gap-2">
      <div class="flex items-center gap-2.5 min-w-0">
        <label title="Klik untuk ganti file logo BAPELTAN" class="w-9 h-9 rounded-full bg-white flex items-center justify-center border-2 border-white/80 shadow-inner overflow-hidden cursor-pointer shrink-0 relative group">
          <img id="appLogoImg" src="images (2).jfif" alt="Logo BAPELTAN" onload="handleLogoLoaded(this)" onerror="handleLogoError(this)" class="w-full h-full object-contain p-0.5" />
          <i id="appLogoFallbackIcon" data-lucide="shield-check" class="hidden w-5 h-5 text-[#0077E6]"></i>
          <input type="file" accept="image/*" onchange="handleCustomLogoUpload(event)" class="hidden" />
        </label>
        <div class="min-w-0">
          <h1 class="font-extrabold text-sm tracking-tight leading-none truncate">BAPELTAN <span class="text-amber-300">Absensi</span></h1>
          <p class="text-[10px] text-blue-100 mt-0.5 font-medium truncate">Foto 100% Akurat &amp; Terverifikasi GPS</p>
        </div>
      </div>
      <div class="flex items-center gap-1 shrink-0">
        <button onclick="switchTab('history')" id="navHistoryBtn" class="relative px-2.5 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 active:scale-95 transition flex items-center gap-1 text-[11px] font-semibold">
          <i data-lucide="history" class="w-3.5 h-3.5"></i>
          <span>Riwayat</span>
          <span id="historyBadge" class="hidden bg-amber-400 text-slate-900 text-[10px] font-extrabold px-1.5 py-0.2 rounded-full">0</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main style="padding-bottom: calc(5rem + env(safe-area-inset-bottom, 0px));" class="flex-1 max-w-[430px] w-full mx-auto px-3 py-3 space-y-3">

    <!-- Navigation Tabs (Kamera vs Riwayat) -->
    <div class="grid grid-cols-2 bg-white p-1 rounded-2xl shadow-sm border border-slate-200/80">
      <button id="tabCamera" onclick="switchTab('camera')" class="py-2 px-2.5 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 bg-[#0077E6] text-white shadow-sm transition">
        <i data-lucide="camera" class="w-3.5 h-3.5"></i>
        Ambil Absen
      </button>
      <button id="tabHistory" onclick="switchTab('history')" class="py-2 px-2.5 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 text-slate-600 hover:bg-slate-50 transition">
        <i data-lucide="clipboard-list" class="w-3.5 h-3.5"></i>
        Riwayat &amp; Share WA
      </button>
    </div>

    <!-- VIEW 1: KAMERA ABSENSI -->
    <div id="viewCamera" class="space-y-3">

      <!-- Card Identitas Pegawai (Collapsible) -->
      <div class="bg-white rounded-2xl p-3 shadow-sm border border-slate-200/80">
        <div class="flex items-center justify-between cursor-pointer" onclick="toggleProfileForm()">
          <div class="flex items-center gap-2 min-w-0">
            <div class="w-8 h-8 rounded-full bg-blue-50 text-[#0077E6] flex items-center justify-center font-bold text-sm border border-blue-100 shrink-0">
              <i data-lucide="user-check" class="w-4 h-4"></i>
            </div>
            <div class="min-w-0">
              <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Identitas Pegawai</p>
              <p id="displayUserSummary" class="text-xs font-bold text-slate-800 truncate">Ketuk untuk isi Nama &amp; Unit Kerja</p>
            </div>
          </div>
          <button type="button" class="text-[11px] font-semibold text-[#0077E6] bg-blue-50 px-2 py-1 rounded-xl flex items-center gap-1 shrink-0">
            <span id="profileToggleText">Ubah</span>
            <i data-lucide="chevron-down" id="profileChevron" class="w-3.5 h-3.5 transition-transform"></i>
          </button>
        </div>

        <div id="profileFormFields" class="mt-3 pt-3 border-t border-slate-100 space-y-2.5 hidden">
          <div>
            <label class="block text-[11px] font-bold text-slate-600 mb-1">Nama Pegawai (User)</label>
            <input type="text" id="inputNama" placeholder="Contoh: Ahmad Fauzi, S.Pt" oninput="saveProfile()" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#0077E6] focus:bg-white transition" />
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-600 mb-1">Unit Kerja</label>
            <input type="text" id="inputUnitKerja" placeholder="Contoh: Balai Pelatihan Tanaman Pangan & Hortikultura" oninput="saveProfile()" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#0077E6] focus:bg-white transition" />
          </div>
        </div>
      </div>

      <!-- Pilihan Status Absen Masuk / Pulang & Pengaturan Jam Masuk -->
      <div class="bg-white rounded-2xl p-3 shadow-sm border border-slate-200/80 space-y-2.5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-600 flex items-center gap-1.5">
            <i data-lucide="clock" class="w-3.5 h-3.5 text-[#0077E6]"></i>
            Jenis Kehadiran
          </span>
          <span id="liveClockBadge" class="text-[11px] font-extrabold bg-slate-100 text-slate-700 px-2 py-0.5 rounded-lg font-mono">00:00:00</span>
        </div>

        <div class="grid grid-cols-2 gap-2">
          <button type="button" id="btnModeMasuk" onclick="setAttendanceType('Absen Masuk')" class="py-2.5 px-2.5 rounded-xl border-2 border-emerald-600 bg-emerald-600 text-white font-bold text-xs flex items-center justify-center gap-1.5 shadow-sm transition active:scale-98">
            <i data-lucide="log-in" class="w-4 h-4"></i>
            Absen Masuk
          </button>
          <button type="button" id="btnModePulang" onclick="setAttendanceType('Absen Pulang')" class="py-2.5 px-2.5 rounded-xl border-2 border-slate-200 bg-white text-slate-700 font-bold text-xs flex items-center justify-center gap-1.5 hover:bg-slate-50 transition active:scale-98">
            <i data-lucide="log-out" class="w-4 h-4"></i>
            Absen Pulang
          </button>
        </div>

        <!-- Info Sudah Absen Masuk Hari Ini -->
        <div id="alreadyCheckedInNotice" class="hidden items-center justify-between gap-2 bg-emerald-50 border border-emerald-200 rounded-xl px-3 py-2 text-[11px] text-emerald-800">
          <span class="font-semibold">Anda sudah <strong>Absen Masuk</strong> hari ini (<strong id="recordedCheckInBadge">--:--</strong>). Menu otomatis ke <strong>Absen Pulang</strong>.</span>
          <button type="button" onclick="resetTodayCheckIn()" class="font-bold text-emerald-700 underline shrink-0">Reset</button>
        </div>

        <!-- Pengaturan Jam Masuk untuk Perhitungan Durasi Kerja saat Absen Pulang -->
        <div id="checkInTimeBox" class="bg-blue-50/80 border border-blue-200/80 rounded-xl p-2.5 flex items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <i data-lucide="briefcase" class="w-4 h-4 text-[#0077E6] shrink-0"></i>
            <div>
              <p class="text-[11px] font-bold text-slate-700">Jam Masuk Hari Ini</p>
              <p class="text-[10px] text-slate-500" id="durationPreviewText">Otomatis hitung lama waktu kerja saat Absen Pulang</p>
            </div>
          </div>
          <input type="time" id="inputCheckInTime" value="06:35" onchange="saveCustomCheckInTime()" class="bg-white border border-blue-300 text-slate-800 font-extrabold text-sm rounded-lg px-2 py-1 focus:outline-none focus:ring-2 focus:ring-[#0077E6]" />
        </div>
      </div>

      <!-- Viewfinder Kamera dengan Live Overlay Persis Referensi -->
      <div class="bg-slate-900 rounded-3xl overflow-hidden shadow-lg border border-slate-800 relative">
        <!-- Aspect Ratio 4:5 Mobile Portrait Container -->
        <div id="cameraContainer" class="relative w-full aspect-[4/5] bg-slate-950 overflow-hidden flex items-center justify-center">
          <!-- Video Stream -->
          <video id="videoPreview" autoplay playsinline muted class="w-full h-full object-cover mirror-video"></video>

          <!-- Fallback Image if user uploads photo or camera unavailable -->
          <img id="uploadedFallbackImg" class="hidden w-full h-full object-cover" alt="Preview Foto" />

          <!-- Camera Error / Permission State -->
          <div id="cameraFallbackUI" class="hidden absolute inset-0 bg-slate-900/95 flex flex-col items-center justify-center p-6 text-center z-20">
            <div class="w-14 h-14 rounded-2xl bg-amber-500/20 text-amber-400 flex items-center justify-center mb-3">
              <i data-lucide="camera-off" class="w-7 h-7"></i>
            </div>
            <h3 class="text-white font-bold text-base mb-1">Izinkan Kamera di Browser</h3>
            <p id="cameraErrorMsg" class="text-slate-300 text-xs mb-3 leading-relaxed">Ketuk tombol <strong>Izinkan Kamera di Browser</strong> di bawah, lalu pilih <strong>Izinkan / Allow</strong> pada popup browser. Jika pernah diblokir, buka ikon kunci/pengaturan alamat di browser dan ubah <strong>Kamera</strong> menjadi <strong>Izinkan</strong>.</p>
            <div class="flex flex-wrap justify-center gap-2">
              <button type="button" onclick="allowBrowserCameraNow()" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-extrabold rounded-xl flex items-center gap-1.5 shadow">
                <i data-lucide="shield-check" class="w-3.5 h-3.5"></i> Izinkan Kamera di Browser
              </button>
              <button type="button" onclick="startCamera()" class="px-4 py-2.5 bg-slate-700 hover:bg-slate-600 text-white text-xs font-bold rounded-xl flex items-center gap-1.5">
                <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> Coba Lagi
              </button>
              <label class="px-4 py-2.5 bg-[#0077E6] hover:bg-blue-600 text-white text-xs font-bold rounded-xl flex items-center gap-1.5 cursor-pointer shadow">
                <i data-lucide="image-plus" class="w-3.5 h-3.5"></i> Ambil / Pilih Foto
                <input type="file" accept="image/*" capture="user" onchange="handleFileUpload(event)" class="hidden" />
              </label>
            </div>
          </div>

          <!-- LIVE OVERLAY PREVIEW (Meniru hasil akhir Timemark / BAPELTAN) -->
          <div class="absolute inset-0 pointer-events-none flex flex-col justify-between z-10">
            <!-- Top Row: Mini Map & Brand Watermark -->
            <div class="p-3 flex items-start justify-between gap-2">
              <!-- Live Mini Map Box -->
              <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-xl overflow-hidden bg-[#e8f0e8] border-2 border-white/80 shadow-md relative shrink-0">
                <canvas id="liveMiniMapCanvas" width="220" height="220" class="w-full h-full object-cover"></canvas>
              </div>

              <!-- Top Right Brand + Logo -->
              <div class="flex items-center gap-2 text-right drop-shadow-[0_1px_3px_rgba(0,0,0,0.85)]">
                <div>
                  <div class="font-extrabold text-sm sm:text-base tracking-tight leading-none">
                    <span class="text-amber-400">BAPELTAN</span> <span class="text-white">Absensi</span>
                  </div>
                  <div class="text-[10px] text-white/95 font-medium mt-0.5">Foto 100% akurat</div>
                </div>
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-white/95 p-0.5 border border-white shadow-md flex items-center justify-center overflow-hidden shrink-0">
                  <img id="overlayLogoImg" src="images (2).jfif" alt="Logo BAPELTAN" onload="handleLogoLoaded(this)" onerror="this.parentElement.classList.add('hidden')" class="w-full h-full object-contain rounded-full" />
                </div>
              </div>
            </div>

            <!-- Middle Right Vertical Verification Text -->
            <div class="absolute right-1.5 top-1/2 -translate-y-1/2 origin-right -rotate-90 translate-x-[42%] opacity-80 drop-shadow-[0_1px_2px_rgba(0,0,0,0.9)]">
              <span id="liveVerifyCode" class="text-[9px] font-mono tracking-widest text-white font-semibold uppercase">XUBELTG2G69XG9 &nbsp; BAPELTAN Verified</span>
            </div>

            <!-- Bottom Overlay Info + Footer Banner -->
            <div class="w-full">
              <div class="px-3 pb-2.5 bg-gradient-to-t from-black/65 via-black/30 to-transparent pt-8 flex items-end justify-between gap-2.5">
                <div class="min-w-0 flex-1">
                  <!-- Badge Status + Jam Besar -->
                  <div class="inline-flex items-stretch rounded-lg overflow-hidden shadow-md mb-2">
                    <span id="overlayStatusBadge" class="bg-emerald-600 text-white font-bold text-xs sm:text-sm px-2.5 py-1 flex items-center transition-colors">
                      Absen Masuk
                    </span>
                    <span id="overlayTimeBig" class="bg-white text-slate-950 font-black text-base sm:text-lg px-2.5 py-0.5 flex items-center tracking-tight">
                      06:35
                    </span>
                  </div>

                  <!-- Tanggal & Alamat dengan garis vertikal -->
                  <div id="overlayAccentBorder" class="border-l-[3px] border-emerald-600 pl-2.5 space-y-0.5 drop-shadow-[0_1px_3px_rgba(0,0,0,0.9)] transition-colors">
                    <p id="overlayDateText" class="text-white font-bold text-xs sm:text-sm leading-snug">Senin, 23 November 2026</p>
                    <p id="overlayAddressText" class="text-white/95 text-[11px] sm:text-xs leading-snug line-clamp-2">Mendeteksi lokasi GPS...</p>
                    <p id="overlayUserText" class="text-amber-200 font-semibold text-[10px] sm:text-[11px] hidden"></p>
                  </div>

                  <!-- Verified Shield Line -->
                  <div class="flex items-center gap-1 mt-1.5 text-white/90 text-[10px] drop-shadow-[0_1px_2px_rgba(0,0,0,0.9)]">
                    <i data-lucide="shield-check" class="w-3.5 h-3.5 text-white"></i>
                    <span>BAPELTAN Absensi menjamin keaslian waktu</span>
                  </div>
                </div>

                <!-- Logo di Sebelah Kanan Banner Tanggal & Keterangan Absen (Bisa Diubah) -->
                <label title="Klik untuk ubah logo di banner tanggal & foto" class="pointer-events-auto w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white/95 p-0.5 border-2 border-white shadow-lg flex items-center justify-center overflow-hidden shrink-0 cursor-pointer active:scale-95 transition">
                  <img id="dateBannerLogoImg" src="images (2).jfif" alt="Logo Banner Tanggal" onload="handleLogoLoaded(this)" onerror="this.parentElement.classList.add('hidden')" class="w-full h-full object-contain rounded-full" />
                  <input type="file" accept="image/*" onchange="handleCustomLogoUpload(event)" class="hidden" />
                </label>
              </div>

              <!-- Footer Banner (Hijau untuk Absen Masuk, Biru untuk Absen Pulang) -->
              <div id="overlayFooterBanner" class="bg-emerald-600 text-white px-3.5 py-2 flex items-center justify-between transition-colors hidden">
