  <!-- Hidden High-Res Canvas for Final Watermark Generation -->
  <canvas id="exportCanvas" class="hidden"></canvas>

  <script>
    // ==========================================
    // STATE & KONFIGURASI APLIKASI
    // ==========================================
    const STATE = {
      attendanceType: 'Absen Masuk', // 'Absen Masuk' | 'Absen Pulang'
      isMirrored: true,
      facingMode: 'user',
      stream: null,
      uploadedImageObj: null,
      coords: {
        lat: -6.8358,
        lng: 107.2625,
        accuracy: 15,
        isLive: false
      },
      address: 'Neglasari, Kec. Bojongpicung, Kabupaten Cianjur, Jawa Barat 43283',
      roadName: 'Jl. Moch Ali',
      areaName: 'Bojongpicung',
      verificationCode: generateVerificationCode(),
      currentResultDataUrl: null,
      currentResultRecord: null,
      history: [],
      logoImageObj: null,
      autoCameraRetryBound: false,
      isStartingCamera: false
    };

    const HARI_ID = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
    const BULAN_ID = [
      'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
      'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
    ];

    // ==========================================
    // INISIALISASI SAAT HALAMAN DIMUAT
    // ==========================================
    window.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      if (!STATE.logoImageObj) {
        const defaultLogo = window.createDefaultBapeltanLogoDataUrl();
        window.syncLogoToAllTargets(defaultLogo);
      }
      loadLocalStorageData();
      updateClockAndOverlays();
      setInterval(updateClockAndOverlays, 1000);
      drawMiniMap(document.getElementById('liveMiniMapCanvas'), STATE.coords.lat, STATE.coords.lng, STATE.roadName, STATE.areaName);
      bindAlwaysAllowCameraListeners();
      requestAlwaysAllowCamera(null, { silent: true });
      refreshLocation(false);
    });

    function generateVerificationCode() {
      const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
      let code = '';
      for (let i = 0; i < 14; i++) {
        code += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return code;
    }

    function showToast(message, type = 'info') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      const colors = {
        success: 'bg-emerald-600 text-white',
        error: 'bg-rose-600 text-white',
        info: 'bg-slate-900 text-white'
      };
      toast.className = `${colors[type] || colors.info} px-4 py-2.5 rounded-2xl shadow-xl text-xs font-bold flex items-center justify-between gap-2 pointer-events-auto transition-all duration-300`;
      toast.innerHTML = `<span>${message}</span>`;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(-8px)';
        setTimeout(() => toast.remove(), 300);
      }, 3200);
    }

    // ==========================================
    // PENYIMPANAN LOKAL (PROFILE, JAM MASUK, RIWAYAT)
    // ==========================================
    function loadLocalStorageData() {
      try {
        const savedLogo = localStorage.getItem('bapeltan_custom_logo');
        if (savedLogo) {
          applyLogoDataUrl(savedLogo);
        } else if (!STATE.logoImageObj) {
          applyLogoDataUrl(window.createDefaultBapeltanLogoDataUrl());
        }

        const profile = JSON.parse(localStorage.getItem('bapeltan_profile') || '{}');
        if (profile.nama) document.getElementById('inputNama').value = profile.nama;
        if (profile.unitKerja) document.getElementById('inputUnitKerja').value = profile.unitKerja;
        updateProfileSummary();

        // Cek jam masuk hari ini
        const todayKey = getTodayDateKey();
        const savedCheckIn = JSON.parse(localStorage.getItem('bapeltan_checkin_' + todayKey) || 'null');
        if (savedCheckIn && savedCheckIn.time) {
          document.getElementById('inputCheckInTime').value = savedCheckIn.time;
          applyCheckInLockState(true, savedCheckIn.time);
          setAttendanceType('Absen Pulang');
        }

        // Load riwayat lokal saja
        STATE.history = JSON.parse(localStorage.getItem('bapeltan_history') || '[]');
        renderHistoryList();
      } catch (e) {
        console.error('Gagal memuat localStorage:', e);
      }
    }

    function getTodayDateKey() {
      const now = new Date();
      return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    }

    function saveProfile() {
      const profile = {
        nama: document.getElementById('inputNama').value.trim(),
        unitKerja: document.getElementById('inputUnitKerja').value.trim()
      };
      localStorage.setItem('bapeltan_profile', JSON.stringify(profile));
      updateProfileSummary();
    }

    function updateProfileSummary() {
      const nama = document.getElementById('inputNama').value.trim();
      const unitKerja = document.getElementById('inputUnitKerja').value.trim();
      const summaryEl = document.getElementById('displayUserSummary');
      const overlayUserEl = document.getElementById('overlayUserText');

      if (nama && unitKerja) {
        summaryEl.textContent = `${nama} • ${unitKerja}`;
        overlayUserEl.textContent = `${nama} • ${unitKerja}`;
        overlayUserEl.classList.remove('hidden');
      } else if (nama) {
        summaryEl.textContent = nama;
        overlayUserEl.textContent = nama;
        overlayUserEl.classList.remove('hidden');
      } else if (unitKerja) {
        summaryEl.textContent = unitKerja;
        overlayUserEl.textContent = unitKerja;
        overlayUserEl.classList.remove('hidden');
      } else {
        summaryEl.textContent = 'Ketuk untuk isi Nama & Unit Kerja';
        overlayUserEl.classList.add('hidden');
      }
    }

    function toggleProfileForm() {
      const fields = document.getElementById('profileFormFields');
      const chevron = document.getElementById('profileChevron');
      const toggleText = document.getElementById('profileToggleText');
      const isHidden = fields.classList.contains('hidden');
      if (isHidden) {
        fields.classList.remove('hidden');
        chevron.style.transform = 'rotate(180deg)';
        toggleText.textContent = 'Tutup';
      } else {
        fields.classList.add('hidden');
        chevron.style.transform = 'rotate(0deg)';
        toggleText.textContent = 'Ubah';
      }
    }

    function saveCustomCheckInTime() {
      const val = document.getElementById('inputCheckInTime').value;
      if (val) {
        const todayKey = getTodayDateKey();
        localStorage.setItem('bapeltan_checkin_' + todayKey, JSON.stringify({ time: val }));
        applyCheckInLockState(true, val);
        updateClockAndOverlays();
      }
    }

    function applyCheckInLockState(hasCheckedIn, checkInTime = '') {
      const btnMasuk = document.getElementById('btnModeMasuk');
      const btnPulang = document.getElementById('btnModePulang');
      const grid = btnMasuk ? btnMasuk.parentElement : null;
      const notice = document.getElementById('alreadyCheckedInNotice');
      const badge = document.getElementById('recordedCheckInBadge');

      if (!btnMasuk || !btnPulang || !grid) return;

      if (hasCheckedIn) {
        btnMasuk.classList.add('hidden');
        grid.classList.remove('grid-cols-2');
        grid.classList.add('grid-cols-1');
        if (notice) {
          notice.classList.remove('hidden');
          notice.classList.add('flex');
        }
        if (badge && checkInTime) {
          badge.textContent = checkInTime;
        }
      } else {
        btnMasuk.classList.remove('hidden');
        grid.classList.remove('grid-cols-1');
        grid.classList.add('grid-cols-2');
        if (notice) {
          notice.classList.add('hidden');
          notice.classList.remove('flex');
        }
      }
    }

    function resetTodayCheckIn() {
      const todayKey = getTodayDateKey();
      localStorage.removeItem('bapeltan_checkin_' + todayKey);
      applyCheckInLockState(false);
      setAttendanceType('Absen Masuk');
      showToast('Status absen masuk hari ini direset.', 'info');
    }

    // ==========================================
    // NAVIGASI TAB & MODAL
    // ==========================================
    function switchTab(tab) {
      const viewCam = document.getElementById('viewCamera');
      const viewHist = document.getElementById('viewHistory');
      const tabCam = document.getElementById('tabCamera');
      const tabHist = document.getElementById('tabHistory');

      if (tab === 'camera') {
        viewCam.classList.remove('hidden');
        viewHist.classList.add('hidden');
        tabCam.className = 'py-2.5 px-3 rounded-xl text-xs font-bold flex items-center justify-center gap-2 bg-[#0077E6] text-white shadow-sm transition';
        tabHist.className = 'py-2.5 px-3 rounded-xl text-xs font-bold flex items-center justify-center gap-2 text-slate-600 hover:bg-slate-50 transition';
      } else {
        viewCam.classList.add('hidden');
        viewHist.classList.remove('hidden');
        tabHist.className = 'py-2.5 px-3 rounded-xl text-xs font-bold flex items-center justify-center gap-2 bg-[#0077E6] text-white shadow-sm transition';
        tabCam.className = 'py-2.5 px-3 rounded-xl text-xs font-bold flex items-center justify-center gap-2 text-slate-600 hover:bg-slate-50 transition';
        renderHistoryList();
      }
    }

    function openModal(id) {
      document.getElementById(id).classList.remove('hidden');
    }

    function closeModal(id) {
      document.getElementById(id).classList.add('hidden');
    }

    // ==========================================
    // STATUS ABSENSI & PERHITUNGAN DURASI KERJA
    // ==========================================
    function getAttendanceThemeColor(type = STATE.attendanceType) {
      return type === 'Absen Masuk' ? '#059669' : '#0077E6';
    }

    function setAttendanceType(type) {
      STATE.attendanceType = type;
      const btnMasuk = document.getElementById('btnModeMasuk');
      const btnPulang = document.getElementById('btnModePulang');
      const checkInBox = document.getElementById('checkInTimeBox');
      const badge = document.getElementById('overlayStatusBadge');
      const accentBorder = document.getElementById('overlayAccentBorder');
      const footerBanner = document.getElementById('overlayFooterBanner');

      if (type === 'Absen Masuk') {
        btnMasuk.className = 'py-3 px-3 rounded-xl border-2 border-emerald-600 bg-emerald-600 text-white font-bold text-sm flex items-center justify-center gap-2 shadow-sm transition active:scale-98';
        btnPulang.className = 'py-3 px-3 rounded-xl border-2 border-slate-200 bg-white text-slate-700 font-bold text-sm flex items-center justify-center gap-2 hover:bg-slate-50 transition active:scale-98';
        checkInBox.classList.add('opacity-60');
        if (badge) badge.className = 'bg-emerald-600 text-white font-bold text-xs sm:text-sm px-2.5 py-1 flex items-center transition-colors';
        if (accentBorder) accentBorder.className = 'border-l-[3px] border-emerald-600 pl-2.5 space-y-0.5 drop-shadow-[0_1px_3px_rgba(0,0,0,0.9)] transition-colors';
        if (footerBanner) footerBanner.className = 'bg-emerald-600 text-white px-3.5 py-2 flex items-center justify-between transition-colors';
      } else {
        btnPulang.className = 'py-3 px-3 rounded-xl border-2 border-[#0077E6] bg-[#0077E6] text-white font-bold text-sm flex items-center justify-center gap-2 shadow-sm transition active:scale-98';
        btnMasuk.className = 'py-3 px-3 rounded-xl border-2 border-slate-200 bg-white text-slate-700 font-bold text-sm flex items-center justify-center gap-2 hover:bg-slate-50 transition active:scale-98';
        checkInBox.classList.remove('opacity-60');
        if (badge) badge.className = 'bg-[#0077E6] text-white font-bold text-xs sm:text-sm px-2.5 py-1 flex items-center transition-colors';
        if (accentBorder) accentBorder.className = 'border-l-[3px] border-[#0077E6] pl-2.5 space-y-0.5 drop-shadow-[0_1px_3px_rgba(0,0,0,0.9)] transition-colors';
        if (footerBanner) footerBanner.className = 'bg-[#0077E6] text-white px-3.5 py-2 flex items-center justify-between transition-colors';
      }

      updateClockAndOverlays();
    }

    function calculateAttendanceMetrics(nowDate) {
      const hh = String(nowDate.getHours()).padStart(2, '0');
      const mm = String(nowDate.getMinutes()).padStart(2, '0');
      const currentTimeStr = `${hh}:${mm}`;
      const checkInInput = document.getElementById('inputCheckInTime').value || '06:35';

      if (STATE.attendanceType === 'Absen Masuk') {
        return {
          currentTimeStr,
          checkInTime: currentTimeStr,
          durationText: ''
        };
      } else {
        const [inH, inM] = checkInInput.split(':').map(Number);
        const startTotalMins = (inH * 60) + inM;
        const endTotalMins = (nowDate.getHours() * 60) + nowDate.getMinutes();

        let diffMins = endTotalMins - startTotalMins;
        if (diffMins < 0) diffMins += 24 * 60;

        const durH = Math.floor(diffMins / 60);
        const durM = diffMins % 60;

        return {
          currentTimeStr,
          checkInTime: checkInInput,
          durationText: `${durH} h ${durM} mnt`
        };
      }
    }

    function formatIndonesianDate(dateObj) {
      const dayName = HARI_ID[dateObj.getDay()];
      const dayNum = dateObj.getDate();
      const monthName = BULAN_ID[dateObj.getMonth()];
      const yearNum = dateObj.getFullYear();
      return `${dayName}, ${dayNum} ${monthName} ${yearNum}`;
    }

    function updateClockAndOverlays() {
      const now = new Date();
      const hh = String(now.getHours()).padStart(2, '0');
      const mm = String(now.getMinutes()).padStart(2, '0');
      const ss = String(now.getSeconds()).padStart(2, '0');

      document.getElementById('liveClockBadge').textContent = `${hh}:${mm}:${ss}`;
      document.getElementById('overlayStatusBadge').textContent = STATE.attendanceType;
      document.getElementById('overlayTimeBig').textContent = `${hh}:${mm}`;
      document.getElementById('overlayDateText').textContent = formatIndonesianDate(now);
      document.getElementById('overlayAddressText').textContent = STATE.address;
      document.getElementById('liveVerifyCode').innerHTML = `${STATE.verificationCode} &nbsp; BAPELTAN Verified`;

      const metrics = calculateAttendanceMetrics(now);
      const leftLabel = document.getElementById('overlayLeftLabel');
      const leftValue = document.getElementById('overlayLeftValue');
      const rightBox = document.getElementById('overlayRightBox');
      const footerBanner = document.getElementById('overlayFooterBanner');
      const leftBox = document.getElementById('overlayLeftBox');

      if (STATE.attendanceType === 'Absen Masuk') {
        if (footerBanner) {
          footerBanner.classList.add('hidden');
          footerBanner.classList.remove('flex');
        }
        if (leftBox) leftBox.classList.remove('text-center');
        leftLabel.textContent = 'Jam Masuk';
        leftValue.textContent = metrics.currentTimeStr;
        rightBox.classList.add('hidden');
      } else {
        if (footerBanner) {
          footerBanner.classList.remove('hidden');
          footerBanner.classList.add('flex');
          footerBanner.classList.remove('justify-center');
          footerBanner.classList.add('justify-between');
        }
        if (leftBox) leftBox.classList.remove('text-center');
        leftLabel.textContent = 'Jam Masuk';
        leftValue.textContent = metrics.checkInTime;
        rightBox.classList.remove('hidden');
        document.getElementById('overlayWorkDuration').textContent = metrics.durationText;
      }
    }

    // ==========================================
