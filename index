      ctx.fillRect(0, H - 520, W, 520 - footerH);

      // 5. Baris Verifikasi Shield di atas Footer
      const shieldY = footerY - 26;
      ctx.save();
      ctx.shadowColor = 'rgba(0,0,0,0.8)';
