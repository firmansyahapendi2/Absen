      ctx.shadowColor = 'rgba(0,0,0,0.35)';
      ctx.shadowBlur = 12;
      ctx.shadowOffsetY = 4;
      drawRoundedRect(ctx, mapBoxX, mapBoxY, mapBoxW, mapBoxH, 22);
      ctx.fillStyle = '#ffffff';
      ctx.fill();
      ctx.restore();

      ctx.save();
      drawRoundedRect(ctx, mapBoxX + 4, mapBoxY + 4, mapBoxW - 8, mapBoxH - 8, 18);
