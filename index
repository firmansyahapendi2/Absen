      }

      const now = new Date();
      const metrics = calculateAttendanceMetrics(now);
      const dateStr = formatIndonesianDate(now);
      const verifyCode = STATE.verificationCode;
      const themeColor = getAttendanceThemeColor(STATE.attendanceType);

