    // ==========================================
    // GEOLOCATION GPS & REVERSE GEOCODING
    // ==========================================
    function refreshLocation(manualTrigger = false) {
      const coordsBadge = document.getElementById('gpsCoordsBadge');
      const dot = document.getElementById('gpsIndicatorDot');

      if (!navigator.geolocation) {
        coordsBadge.textContent = 'GPS Tidak Didukung';
        if (manualTrigger) showToast('Perangkat tidak mendukung GPS.', 'error');
        return;
      }

      coordsBadge.textContent = 'Mencari GPS...';
      dot.className = 'w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping absolute top-2 right-2';

      navigator.geolocation.getCurrentPosition(
        async (pos) => {
          const lat = pos.coords.latitude;
          const lng = pos.coords.longitude;
          STATE.coords = {
            lat,
            lng,
            accuracy: Math.round(pos.coords.accuracy || 10),
            isLive: true
          };

          coordsBadge.textContent = `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
          dot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400 absolute top-2 right-2';

          await reverseGeocode(lat, lng);
          drawMiniMap(document.getElementById('liveMiniMapCanvas'), lat, lng, STATE.roadName, STATE.areaName);
          if (manualTrigger) showToast('Lokasi GPS berhasil diperbarui!', 'success');
        },
        (err) => {
          console.warn('Geolocation error:', err);
          coordsBadge.textContent = 'GPS Default/Offline';
          dot.className = 'w-2.5 h-2.5 rounded-full bg-rose-400 absolute top-2 right-2';
          document.getElementById('cardAddressDisplay').textContent = STATE.address;
          if (manualTrigger) {
            showToast('Gagal mengambil GPS otomatis. Anda bisa edit alamat secara manual.', 'error');
          }
        },
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
      );
    }

    async function reverseGeocode(lat, lng) {
      try {
        const res = await fetch(
          `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}&accept-language=id`
        );
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        const addr = data.address || {};

        const desa = addr.village || addr.suburb || addr.hamlet || addr.neighbourhood || '';
        const kec = addr.city_district || addr.district || addr.subdistrict || '';
        const kab = addr.county || addr.city || addr.town || '';
        const prov = addr.state || '';
        const kodepos = addr.postcode || '';

        STATE.roadName = addr.road || desa || 'Jl. Utama';
        STATE.areaName = kec || kab || 'Lokasi Tugas';

        const parts = [];
        if (desa) parts.push(desa);
        if (kec) parts.push(kec.toLowerCase().startsWith('kec') ? kec : `Kec. ${kec}`);
        if (kab) parts.push(kab);
        if (prov || kodepos) parts.push(`${prov} ${kodepos}`.trim());

        const formatted = parts.length > 0 ? parts.join(', ') : (data.display_name || STATE.address);
        STATE.address = formatted;
        document.getElementById('cardAddressDisplay').textContent = formatted;
        document.getElementById('inputManualAddress').value = formatted;
        updateClockAndOverlays();
      } catch (e) {
        console.warn('Reverse geocoding fallback:', e);
        document.getElementById('cardAddressDisplay').textContent = STATE.address;
      }
    }

