      }
    }

    // ==========================================
    // RENDER PETA MINI (CANVAS VECTOR STYLE TIMEMARK)
    // ==========================================
    function drawMiniMap(canvas, lat, lng, roadLabel, areaLabel) {
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const w = canvas.width;
      const h = canvas.height;

      // Background dasar peta (krem/hijau muda seperti Google Maps)
      ctx.fillStyle = '#f2efe9';
      ctx.fillRect(0, 0, w, h);

      // Area hijau taman/sawah berdasarkan hash koordinat
      const seed = Math.abs(Math.sin(lat * 1000 + lng * 1000));
      ctx.fillStyle = '#ccebc5';
      ctx.beginPath();
      ctx.moveTo(w * 0.45, 0);
      ctx.lineTo(w, 0);
      ctx.lineTo(w, h * (0.55 + seed * 0.2));
      ctx.lineTo(w * 0.35, h * 0.45);
      ctx.closePath();
      ctx.fill();

      // Aliran sungai biru muda
      ctx.strokeStyle = '#9ecae1';
      ctx.lineWidth = w * 0.035;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(w * 0.15, h * 0.32);
      ctx.quadraticCurveTo(w * 0.55, h * 0.42, w * 0.92, h * 0.12);
      ctx.stroke();

      // Jaringan jalan putih & kuning
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = w * 0.055;
      ctx.beginPath();
      // Jalan vertikal utama
      ctx.moveTo(w * 0.48, 0);
      ctx.lineTo(w * 0.46, h);
      // Jalan horizontal
      ctx.moveTo(0, h * 0.62);
      ctx.lineTo(w, h * 0.58);
      // Jalan cabang
      ctx.moveTo(0, h * 0.25);
      ctx.lineTo(w * 0.48, h * 0.35);
      ctx.stroke();

      // Jalan arteri kuning tipis
      ctx.strokeStyle = '#fed976';
      ctx.lineWidth = w * 0.03;
      ctx.beginPath();
      ctx.moveTo(0, h * 0.85);
      ctx.lineTo(w, h * 0.80);
      ctx.stroke();

      // Label nama area & jalan
      ctx.fillStyle = '#475569';
      ctx.font = `600 ${Math.round(w * 0.068)}px Inter, sans-serif`;
      ctx.fillText((areaLabel || 'Lokasi').slice(0, 14), w * 0.06, h * 0.81);

      ctx.save();
      ctx.translate(w * 0.43, h * 0.45);
      ctx.rotate(Math.PI / 2);
      ctx.fillStyle = '#334155';
      ctx.font = `600 ${Math.round(w * 0.055)}px Inter, sans-serif`;
      ctx.fillText((roadLabel || 'Jl. Utama').slice(0, 14), 0, 0);
      ctx.restore();

      // Kerucut arah pandang hijau di titik tengah
      const cx = w * 0.48;
      const cy = h * 0.46;
      const grad = ctx.createRadialGradient(cx, cy, 2, cx, cy, w * 0.22);
      grad.addColorStop(0, 'rgba(34, 197, 94, 0.65)');
      grad.addColorStop(1, 'rgba(34, 197, 94, 0)');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.arc(cx, cy, w * 0.22, Math.PI * 0.85, Math.PI * 1.25);
      ctx.closePath();
      ctx.fill();

      // Pin Lokasi Biru (Teardrop)
      const pinR = w * 0.068;
      const pinY = cy - pinR * 1.5;
      ctx.fillStyle = '#0077E6';
      ctx.beginPath();
      ctx.arc(cx, pinY, pinR, Math.PI * 0.8, Math.PI * 2.2);
      ctx.lineTo(cx, cy);
      ctx.closePath();
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2;
      ctx.stroke();

      // Titik putih di tengah pin
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(cx, pinY, pinR * 0.38, 0, Math.PI * 2);
      ctx.fill();

      // Label kecil GPS Map di kiri bawah kotak peta
      ctx.font = `800 ${Math.round(w * 0.065)}px Inter, sans-serif`;
      ctx.fillStyle = '#2563eb';
      ctx.fillText('GPS', w * 0.06, h * 0.94);
      ctx.fillStyle = '#dc2626';
      ctx.fillText('Map', w * 0.23, h * 0.94);
    }

    // ==========================================
    // GENERATOR FOTO WATERMARK HIGH-RES (CANVAS)
    // ==========================================
    function wrapCanvasText(ctx, text, maxWidth, maxLines = 2) {
      const words = text.split(' ');
      const lines = [];
      let currentLine = '';

      for (let i = 0; i < words.length; i++) {
        const testLine = currentLine ? `${currentLine} ${words[i]}` : words[i];
        const width = ctx.measureText(testLine).width;
        if (width > maxWidth && currentLine) {
          lines.push(currentLine);
          currentLine = words[i];
          if (lines.length === maxLines) break;
        } else {
          currentLine = testLine;
        }
      }
      if (currentLine && lines.length < maxLines) {
        lines.push(currentLine);
      }
      return lines;
    }

    function drawRoundedRect(ctx, x, y, width, height, radius) {
      ctx.beginPath();
      ctx.moveTo(x + radius, y);
      ctx.lineTo(x + width - radius, y);
      ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
      ctx.lineTo(x + width, y + height - radius);
      ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
      ctx.lineTo(x + radius, y + height);
      ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
      ctx.lineTo(x, y + radius);
      ctx.quadraticCurveTo(x, y, x + radius, y);
      ctx.closePath();
    }

    function captureAttendancePhoto() {
      const video = document.getElementById('videoPreview');
      const canvas = document.getElementById('exportCanvas');
      const ctx = canvas.getContext('2d');

      const W = 1080;
      const H = 1440; // Rasio 3:4 Portrait HD
      canvas.width = W;
      canvas.height = H;

      // 1. Gambar Sumber Foto (Video Stream atau Uploaded Image atau Placeholder)
      ctx.fillStyle = '#1e293b';
      ctx.fillRect(0, 0, W, H);

      if (STATE.uploadedImageObj) {
        drawImageCover(ctx, STATE.uploadedImageObj, 0, 0, W, H, false);
      } else if (video && video.readyState >= 2 && !video.classList.contains('hidden')) {
        drawImageCover(ctx, video, 0, 0, W, H, STATE.isMirrored);
      } else {
        showToast('Kamera belum aktif. Silakan izinkan kamera atau pilih foto dari galeri.', 'error');
